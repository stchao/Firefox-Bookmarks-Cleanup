{
  "ConnectionStrings": {
    "BrowserDb": "",
    "Db": ""
  },
  "FolderNamesOrIds": [ "mobile" ],
  "DryRun": false,
  "Exceptions": {
    "IgnoreNonAscii": [
      "’",
      "～"
    ],
    "Replace": {
      // With Unicode: "\u2013": "-"
      "–": "-",
      "—": "-",
      "•": "-",
      "“": "\"",
      "”": "\"",
      "’": "'",
      "…": "...",
      "о": "o"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/bm_cleanup_log_.txt",
          "rollingInterval": "Month",
          "retainedFileCountLimit": 3,
          "shared": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
